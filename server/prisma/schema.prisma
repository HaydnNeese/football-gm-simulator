  assistantAthleticTrainer   Staff?  @relation("AssistantAthleticTrainer", fields: [assistantAthleticTrainerId], references: [id])

  teamDoctorId String? @unique @map("team_doctor_id")
  teamDoctor   Staff?  @relation("TeamDoctor", fields: [teamDoctorId], references: [id])

  physicalTherapistId String? @unique @map("physical_therapist_id")
  physicalTherapist   Staff?  @relation("PhysicalTherapist", fields: [physicalTherapistId], references: [id])

  sportsPsychologistId String? @unique @map("sports_psychologist_id")
  sportsPsychologist   Staff?  @relation("SportsPsychologist", fields: [sportsPsychologistId], references: [id])

  nutritionistId String? @unique @map("nutritionist_id")
  nutritionist   Staff?  @relation("Nutritionist", fields: [nutritionistId], references: [id])

  dataAnalystId String? @unique @map("data_analyst_id")
  dataAnalyst   Staff?  @relation("DataAnalyst", fields: [dataAnalystId], references: [id])

  gameAnalystId String? @unique @map("game_analyst_id")
  gameAnalyst   Staff?  @relation("GameAnalyst", fields: [gameAnalystId], references: [id])

  videoCoordinatorId String? @unique @map("video_coordinator_id")
  videoCoordinator   Staff?  @relation("VideoCoordinator", fields: [videoCoordinatorId], references: [id])

  equipmentManagerId String? @unique @map("equipment_manager_id")
  equipmentManager   Staff?  @relation("EquipmentManager", fields: [equipmentManagerId], references: [id])

  facilityManagerId String? @unique @map("facility_manager_id")
  facilityManager   Staff?  @relation("FacilityManager", fields: [facilityManagerId], references: [id])

  groundskeeperId String? @unique @map("groundskeeper_id")
  groundskeeper   Staff?  @relation("Groundskeeper", fields: [groundskeeperId], references: [id])

  securityManagerId String? @unique @map("security_manager_id")
  securityManager   Staff?  @relation("SecurityManager", fields: [securityManagerId], references: [id])

  players        Player[] @relation("ActiveRoster")
  practiceSquad  Player[] @relation("PracticeSquad")
  injuredReserve Player[] @relation("InjuredReserve")
  suspendedList  Player[] @relation("SuspendedList")

  overallRating   Int?                 @map("overall_rating")
  offensiveScheme OffensiveSchemeEnum? @map("offensive_scheme")
  defensiveScheme DefensiveSchemeEnum? @map("defensive_scheme")
  teamNeeds       PlayerPositionEnum[] @map("team_needs")
  strategy        StrategyEnum?

  wins                 Int?
  losses               Int?
  ties                 Int?
  currentStreak        Int?
  longestWinningStreak Int?
  playoffAppearances   Int?
  superBowlAppearances Int?
  championships        Int?

  capLimit           Int?
  totalPayroll       Int?
  financialHealth    FinancialHealthEnum
  playerContracts    PlayerContract[]    @relation("ContractedTeam")
  revenue            Int?
  expenses           Int?
  profit             Int?
  attendance         Int?
  merchandiseSales   Int?
  jerseySales        Int?
  ticketSales        Int?
  sponsorshipRevenue Int?
  tvRevenue          Int?
  concessionsRevenue Int?

  yearFounded    Int?
  allTimeWins    Int?
  allTimeLosses  Int?
  allTimeTies    Int?
  retiredNumbers Int[]

  fanBaseSize Int?
  prestige    Int?
  rivalTeams  String[]
  mascot      String?

  draftPicks Int[] @map("draft_picks")

  @@map("team")
}

model PlayerContract {
  staff                 Staff[]
  id                    String  @id @default(uuid())
  playerId              String  @unique
  player                Player  @relation("ContractedPlayer", fields: [playerId], references: [id])
  playerCurrentContract Player? @relation("PlayerCurrentContract")

  teamId           String    
  team             Team      @relation("ContractedTeam", fields: [teamId], references: [id])
  signedDate       DateTime?
  startSeason      Int?
  endSeason        Int?
  totalValue       Int?
  averagePerYear   Int?
  totalGuaranteed  Int?
  isRookieContract Boolean?
  isFranchiseTag   Boolean?
  isExtension      Boolean?
  isPlayerOptOut   Boolean?
  isTeamOptOut     Boolean?

  bonuses           ContractBonus[]
  salaries          SalaryByYear[]
  capHits           CapHitByYear[]
  deadCaps          DeadCapByYear[]
  optOutYears       OptOutYear[]
  restructureEvents RestructureEvent[]
  clauses           ContractClause[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("player_contract")
}

model ContractBonus {
  id             String @id @default(uuid())
  contractId     String
  year           Int?
  signingBonus   Int?
  rosterBonus    Int?
  workoutBonus   Int?
  incentiveBonus Int?

  contract PlayerContract @relation(fields: [contractId], references: [id])

  @@map("contract_bonus")
}

model SalaryByYear {
  id         String @id @default(uuid())
  contractId String
  year       Int?
  amount     Int?

  contract PlayerContract @relation(fields: [contractId], references: [id])

  @@map("salary_by_year")
}

model CapHitByYear {
  id         String @id @default(uuid())
  contractId String
  year       Int?
  amount     Int?

  contract PlayerContract @relation(fields: [contractId], references: [id])

  @@map("cap_hit_by_year")
}

model DeadCapByYear {
  id         String @id @default(uuid())
  contractId String
  year       Int?
  amount     Int?

  contract PlayerContract @relation(fields: [contractId], references: [id])

  @@map("dead_cap_by_year")
}

model OptOutYear {
  id         String @id @default(uuid())
  contractId String
  year       Int

  contract PlayerContract @relation(fields: [contractId], references: [id])

  @@map("opt_out_year")
}

model RestructureEvent {
  id                     String    @id @default(uuid())
  contractId             String
  year                   Int?
  date                   DateTime?
  amountConvertedToBonus Int?
  newCapHit              Int?
  newDeadCap             Int?

  contract PlayerContract @relation(fields: [contractId], references: [id])

  @@map("restructure_event")
}

model ContractClause {
  id                      String   @id @default(uuid())
  contractId              String   @unique
  noTradeClause           Boolean?
  injuryGuarantee         Boolean?
  restructureEligible     Boolean?
  earlyTerminationPenalty Float? // % of remaining contract

  contract           PlayerContract    @relation(fields: [contractId], references: [id])
  performanceBonusId String?           @unique
  performanceBonus   PerformanceBonus?
  rosterBonusId      String?           @unique
  rosterBonus        RosterBonus?
  workoutBonusId     String?           @unique
  workoutBonus       WorkoutBonus?
  optionBonusId      String?           @unique
  optionBonus        OptionBonus?

  @@map("contract_clause")
}

model PerformanceBonus {
  id                String @id @default(uuid())
  clauseId          String @unique
  proBowl           Int?
  allPro            Int?
  mvp               Int?
  superBowlMVP      Int?
  playoffAppearance Int?

  clauses        ContractClause @relation(fields: [clauseId], references: [id])
  statMilestones StatMilestone?

  @@map("performance_bonus")
}

model StatMilestone {
  id            String @id @default(uuid())
  performanceId String @unique
  yards         Int?
  touchdowns    Int?
  sacks         Int?
  interceptions Int?

  performanceBonus PerformanceBonus @relation(fields: [performanceId], references: [id])

  @@map("stat_milestone")
}

model RosterBonus {
  id       String   @id @default(uuid())
  clauseId String   @unique
  amount   Int?
  perGame  Boolean?

  clause ContractClause @relation(fields: [clauseId], references: [id])

  @@map("roster_bonus")
}

model WorkoutBonus {
  id          String @id @default(uuid())
  clauseId    String @unique
  amount      Int?
  minWorkouts Int?

  clause ContractClause @relation(fields: [clauseId], references: [id])

  @@map("workout_bonus")
}

model OptionBonus {
  id       String      @id @default(uuid())
  clauseId String      @unique
  year     Int?
  amount   Int?
  type     OptionType?

  clause ContractClause @relation(fields: [clauseId], references: [id])

  @@map("option_bonus")
}

model Agent {
  id                String   @id @default(uuid())
  firstName         String
  lastName          String
  agencyName        String?
  reputation        Int?
  yearsOfExperience Int?
  players           Player[]

  @@map("agent")
}

model Rating {
  id       String  @id @default(uuid())
  playerId String? @unique
  player   Player? @relation(fields: [playerId], references: [id])

  // --- Base Athletic Traits ---
  speed             Int?
  acceleration      Int?
  agility           Int?
  changeOfDirection Int?
  strength          Int?
  impactPower       Int?
  verticalJump      Int?
  stamina           Int?
  toughness         Int?
  awareness         Int?
  discipline        Int?
  injuryRecovery    Int?

  // --- Quarterback-Specific Traits ---
  throwPower          Int?
  throwAccuracyShort  Int?
  throwAccuracyMedium Int?
  throwAccuracyDeep   Int?
  throwOnRun          Int?
  playAction          Int?
  pocketPresence      Int?
  releaseTime         Int?
  decisionMaking      Int?
  scrambling          Int?
  breakSack           Int?
  fieldVision         Int?

  // --- Ball Handling ---
  ballSecurity      Int?
  ballCarrierVision Int?

  // --- Running Traits ---
  breakTackle         Int?
  topBallCarrierSpeed Int?
  trucking            Int?
  elusiveness         Int?
  stiffArm            Int?
  spinMove            Int?
  jukeMove            Int?
  shortYardage        Int?
  goalLine            Int?
  openFieldRunning    Int?

  // --- Receiving Skills ---
  catching         Int?
  catchInTraffic   Int?
  spectacularCatch Int?
  contestedCatches Int?
  yardsAfterCatch  Int?
  jumpBallTiming   Int?

  // --- Route Running ---
  routeRunning Int?
  shortRoute   Int?
  mediumRoute  Int?
  deepRoute    Int?
  separation   Int?
  release      Int?

  // --- Blocking Skills ---
  runBlocking        Int?
  passBlocking       Int?
  pullBlocking       Int?
  scrambleBlocking   Int?
  playActionBlocking Int?
  screenBlocking     Int?
  leadBlocking       Int?

  // --- Defensive Skills ---
  tackling              Int?
  blockShedding         Int?
  blitzing              Int?
  playRecognition       Int?
  openFieldTackling     Int?
  coverageAgainstTEsRBs Int?
  coverageAgainstSlot   Int?
  deepCoverage          Int?
  runDefense            Int?

  // --- Defensive Line Skills ---
  passRush                 Int?
  finessePassRush          Int?
  powerPassRush            Int?
  runStopping              Int?
  penetration              Int?
  edgeSetting              Int?
  disengagement            Int?
  offensiveLineRecognition Int?

  // --- Linebacker Skills ---
  hitPower Int?

  // --- Defensive Back Skills ---
  pressCoverage   Int?
  offBallCoverage Int?
  manCoverage     Int?
  zoneCoverage    Int?
  ballHawking     Int?
  interceptions   Int?
  passDeflection  Int?

  // --- Kicking/Punting Skills ---
  kickPower         Int?
  kickAccuracy      Int?
  puntPower         Int?
  puntAccuracy      Int?
  onsideKickAbility Int?

  // --- Kick Return/Punt Return Skills ---
  kickReturnVision Int?
  puntReturnVision Int?

  @@map("rating")
}

model PlayerStats {
  id       String  @id @default(uuid())
  season   Int?
  playerId String? @unique
  player   Player? @relation(fields: [playerId], references: [id])

  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id])

  gamesPlayed  Int?
  gamesStarted Int?
  snaps        Int?

  // Rushing
  rushingAttempts   Int?
  rushingYards      Int?
  yardsPerCarry     Float?
  yardsAfterContact Int?
  yardsPerGame      Float?
  rushingLong       Int?
  rushingTouchdowns Int?
  fumblesLost       Int?

  // Receiving
  receptions          Int?
  receivingYards      Int?
  yardsPerReception   Float?
  yardsAfterCatch     Int?
  yardsPerTarget      Float?
  airYards            Int?
  receivingLong       Int?
  targets             Int?
  receivingTouchdowns Int?
  drops               Int?

  // Passing
  passingAttempts      Int?
  passingCompletions   Int?
  passingYards         Int?
  yardsPerPass         Float?
  yardsPerCompletion   Float?
  completionPercentage Float?
  passingTouchdowns    Int?
  interceptions        Int?
  sacksTaken           Int?
  passerRating         Float?

  // Blocking (OL)
  pancakes       Int?
  sacksAllowed   Int?
  hurriesAllowed Int?

  // Defense
  tackles             Int?
  tacklesForLoss      Int?
  sacks               Int?
  interceptionsMade   Int?
  forcedFumbles       Int?
  fumbleRecoveries    Int?
  passesDefended      Int?
  defensiveTouchdowns Int?

  // Special Teams
  fieldGoalsMade         Int?
  fieldGoalsAttempted    Int?
  extraPointsMade        Int?
  extraPointsAttempted   Int?
  punts                  Int?
  puntYards              Int?
  kickReturns            Int?
  kickReturnYards        Int?
  puntReturns            Int?
  puntReturnYards        Int?
  specialTeamsTouchdowns Int?

  // Penalties
  penaltiesCommitted Int?
  penaltyYards       Int?

  @@unique([playerId, season])
  @@map("player_stats")
}

model ContractDesires {
  id                          String    @id @default(uuid())
  years                       Int?      @map("years")
  average_salary              Int?      @map("average_salary")
  total_guaranteed            Int?      @map("total_guaranteed")
  signing_bonus_amount        Int?      @map("signing_bonus_amount")
  signing_bonus_percentage    Int?      @map("signing_bonus_percentage")
  signing_bonus_prorate_years Int?      @map("signing_bonus_prorate_years")
  trade_clause                Boolean?  @map("trade_clause")
  injury_guarantee            Boolean?  @map("injury_guarantee")
  roster_bonus_amount         Int?      @map("roster_bonus_amount")
  roster_bonus_date           DateTime? @map("roster_bonus_date")
  workout_bonus_amount        Int?      @map("workout_bonus_amount")
  workout_bonus_percentage    Int?      @map("workout_bonus_percentage")
  incentives                  Json?     @map("incentives")
  opt_out_years               Int[]     @map("opt_out_years")
  is_player_opt_out           Boolean?  @map("is_player_opt_out")
  is_team_opt_out             Boolean?  @map("is_team_opt_out")
  playerId                    String?   @unique @map("player_id")
  player                      Player?   @relation("PlayerToContractDesires", fields: [playerId], references: [id])

  @@map("contract_desires")
}

model Coach {
  id                             String   @id @default(uuid())
  firstName                      String
  lastName                       String
  fullName                       String
  age                            Int
  birthDate                      DateTime
  experience                     Int
  teamId                         String?  @map("team_id")
  team                           Team?    @relation(fields: [teamId], references: [id])
  headCoachOf                    Team?    @relation("HeadCoach")
  assistantHeadCoachOf           Team?    @relation("AssistantHeadCoach")
  offensiveCoordinatorOf         Team?    @relation("OffensiveCoordinator")
  defensiveCoordinatorOf         Team?    @relation("DefensiveCoordinator")
  specialTeamsCoordinatorOf      Team?    @relation("SpecialTeamsCoordinator")
  quarterbackCoachOf             Team?    @relation("QuarterbackCoach")
  runningBacksCoachOf            Team?    @relation("RunningBacksCoach")
  wideReceiversCoachOf           Team?    @relation("WideReceiversCoach")
  tightEndsCoachOf               Team?    @relation("TightEndsCoach")
  offensiveLineCoachOf           Team?    @relation("OffensiveLineCoach")
  defensiveLineCoachOf           Team?    @relation("DefensiveLineCoach")
  linebackersCoachOf             Team?    @relation("LinebackersCoach")
  defensiveBacksCoachOf          Team?    @relation("DefensiveBacksCoach")
  strengthAndConditioningCoachOf Team?    @relation("StrengthAndConditioningCoach")
  qualityControlCoachOffenseOf   Team?    @relation("QualityControlCoachOffense")
  qualityControlCoachDefenseOf   Team?    @relation("QualityControlCoachDefense")
}

model Staff {
  id                          String          @id @default(uuid())
  teamId                      String?         @map("team_id")
  team                        Team?           @relation(fields: [teamId], references: [id])
  firstName                   String          @map("first_name")
  lastName                    String          @map("last_name")
  fullName                    String          @map("full_name")
  age                         Int
  birthDate                   DateTime        @map("birth_date")
  role                        StaffRole
  hireDate                    DateTime        @default(now()) @map("hire_date")
  contractId                  String?         @map("contract_id")
  contract                    PlayerContract? @relation(fields: [contractId], references: [id])
  teamOwnerOf                 Team?           @relation("TeamOwner")
  teamPresidentOf             Team?           @relation("TeamPresident")
  generalManagerOf            Team?           @relation("GeneralManager")
  assistantGeneralManagerOf   Team?           @relation("AssistantGeneralManager")
  mediaRelationsManagerOf     Team?           @relation("MediaRelationsManager")
  capSpecialistOf             Team?           @relation("CapSpecialist")
  directorPlayerPersonnelOf   Team?           @relation("DirectorPlayerPersonnel")
  directorOfProScoutingOf     Team?           @relation("DirectorOfProScouting")
  directorOfCollegeScoutingOf Team?           @relation("DirectorOfCollegeScouting")
  proScoutOfId                String?         @map("pro_scout_of_id")
  proScoutOf                  Team?           @relation("ProScouts", fields: [proScoutOfId], references: [id], map: "staff_pro_scout_of_fkey")
  nationalScoutOfId           String?         @map("national_scout_of_id")
  nationalScoutOf             Team?           @relation("NationalScouts", fields: [nationalScoutOfId], references: [id], map: "staff_national_scout_of_fkey")
  regionalScoutOfId           String?         @map("regional_scout_of_id")
  regionalScoutOf             Team?           @relation("RegionalScouts", fields: [regionalScoutOfId], references: [id], map: "staff_regional_scout_of_fkey")
  headAthleticTrainerOf       Team?           @relation("HeadAthleticTrainer")
  assistantAthleticTrainerOf  Team?           @relation("AssistantAthleticTrainer")
  teamDoctorOf                Team?           @relation("TeamDoctor")
  physicalTherapistOf         Team?           @relation("PhysicalTherapist")
  sportsPsychologistOf        Team?           @relation("SportsPsychologist")
  nutritionistOf              Team?           @relation("Nutritionist")
  dataAnalystOf               Team?           @relation("DataAnalyst")
  gameAnalystOf               Team?           @relation("GameAnalyst")
  videoCoordinatorOf          Team?           @relation("VideoCoordinator")
  equipmentManagerOf          Team?           @relation("EquipmentManager")
  facilityManagerOf           Team?           @relation("FacilityManager")
  groundskeeperOf             Team?           @relation("Groundskeeper")
  securityManagerOf           Team?           @relation("SecurityManager")
}
