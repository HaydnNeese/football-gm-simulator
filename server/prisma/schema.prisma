model Player {
  id           String    @id @default(uuid()) @map("id")
  externalId   String    @unique
  firstName    String?   @map("first_name")
  lastName     String?   @map("last_name")
  fullName     String?   @map("full_name")
  age          Int?      @map("age")
  birthDate    DateTime? @map("birth_date")
  college      String?   @map("college")
  jerseyNumber Int?      @map("jersey_number")

  heightInInches Int? @map("height_in_inches")
  weightInPounds Int? @map("weight_in_pounds")

  teamId String? @map("team_id")
  team   Team?   @relation("ActiveRoster", fields: [teamId], references: [id])

  practiceSquadTeamId  String? @map("practice_squad_team_id")
  practiceSquadTeam    Team?   @relation("PracticeSquad", fields: [practiceSquadTeamId], references: [id])
  injuredReserveTeamId String? @map("injured_reserve_team_id")
  injuredReserveTeam   Team?   @relation("InjuredReserve", fields: [injuredReserveTeamId], references: [id])
  suspendedListTeamId  String? @map("suspended_list_team_id")
  suspendedListTeam    Team?   @relation("SuspendedList", fields: [suspendedListTeamId], references: [id])

  positionAbbreviation String?         @map("position_abbreviation")
  currentContractId    String?         @unique @map("current_contract_id")
  currentContract      PlayerContract? @relation("PlayerCurrentContract", fields: [currentContractId], references: [id], map: "player_current_contract_fkey")

  agentId String? @unique @map("agent_id")
  agent   Agent?  @relation(fields: [agentId], references: [id])

  ratingsId String? @unique @map("ratings_id")
  ratings   Rating?

  statsId String?      @unique @map("stats_id")
  stats   PlayerStats?

  // --- Enums ---
  position          PlayerPositionEnum?
  expectedRole      PlayerRoleEnum?              @map("expected_role")
  actualRole        PlayerRoleEnum?              @map("actual_role")
  recordsHeld       FootballRecordEnum[]         @map("records_held")
  currentInjury     InjuryTypeEnum?              @map("current_injury")
  injuryHistory     InjuryTypeEnum[]             @map("injury_history")
  personalityTraits PlayerPersonalityTraitEnum[] @map("personality_traits")
  offFieldConcerns  OffFieldConcernTypeEnum[]    @map("off_field_concerns")
  pastEvents        PlayerEventEnum[]            @map("past_events")

  // --- Flags ---
  isStarter       Boolean @default(false) @map("is_starter")
  isCaptain       Boolean @default(false) @map("is_captain")
  isFreeAgent     Boolean @default(false) @map("is_free_agent")
  isRetired       Boolean @default(false) @map("is_retired")
  isSuspended     Boolean @default(false) @map("is_suspended")
  isPracticeSquad Boolean @default(false) @map("is_practice_squad")
  isTradeBlock    Boolean @default(false) @map("is_trade_block")
  offense         Boolean @default(false)
  defense         Boolean @default(false)
  specialTeams    Boolean @default(false) @map("special_teams")

  // --- Draft & Contract ---
  draftYear                 Int?                           @map("draft_year")
  draftRound                Int?                           @map("draft_round")
  isRecordHolder            Boolean                        @default(false) @map("is_record_holder")
  playerContract            PlayerContract?                @relation("ContractedPlayer")
  contractDesiresId         String?                        @unique @map("contract_desires_id")
  contractDesires           ContractDesires?               @relation("PlayerToContractDesires")
  contractNegotiationStatus ContractNegotiationStatusEnum? @map("contract_negotiation_status")
  lastContractUpdate        DateTime?                      @map("last_contract_update")

  // --- Ratings ---
  performanceRating Int? @map("performance_rating")
  impactRating      Int? @map("impact_rating")
  potential         Int?
  experience        Int?

  // --- Injury ---
  injuryStatus             InjuryStatus? @default(Active)
  isInjured                Boolean?      @default(false) @map("is_injured")
  injuryProneness          Boolean?      @default(false) @map("injury_proneness")
  expectedReturnFromInjury DateTime?     @map("expected_return_from_injury")

  // --- Intangibles ---
  morale       Int?
  leadership   Int?
  adaptability Int?
  workEthic    Int? @map("work_ethic")
  consistency  Int?
  clutchFactor Int?
  footballIQ   Int? @map("football_iq")
  popularity   Int?

  // --- Training ---
  trainingFocus    String? @map("training_focus")
  trainingProgress Int?    @map("training_progress")

  createdAt DateTime? @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  @@map("player")
}

model Team {
  playerStats    PlayerStats[]
  coaches        Coach[]
  staff          Staff[]
  id             String        @id @default(uuid())
  name           String?       @unique
  nickname       String?       @unique
  location       String?
  abbreviation   String        @unique
  stadium        String?
  logoUrl        String?       @map("logo_url")
  colorPrimary   String?       @map("color_primary") // hex color code
  colorSecondary String?       @map("color_secondary") // hex color code
  colorTertiary  String?       @map("color_tertiary") // hex color code

  division   DivisionEnum?   @map("division")
  conference ConferenceEnum? @map("conference")

  // Coach, staff, and front office fields remain unchanged ...
  headCoachId String? @unique @map("head_coach_id")
  headCoach   Coach?  @relation("HeadCoach", fields: [headCoachId], references: [id])

  assistantHeadCoachId String? @unique @map("assistant_head_coach_id")
  assistantHeadCoach   Coach?  @relation("AssistantHeadCoach", fields: [assistantHeadCoachId], references: [id])

  offensiveCoordinatorId String? @unique @map("offensive_coordinator_id")
  offensiveCoordinator   Coach?  @relation("OffensiveCoordinator", fields: [offensiveCoordinatorId], references: [id])

  defensiveCoordinatorId String? @unique @map("defensive_coordinator_id")
  defensiveCoordinator   Coach?  @relation("DefensiveCoordinator", fields: [defensiveCoordinatorId], references: [id])

  specialTeamsCoordinatorId String? @unique @map("special_teams_coordinator_id")
  specialTeamsCoordinator   Coach?  @relation("SpecialTeamsCoordinator", fields: [specialTeamsCoordinatorId], references: [id])

  quarterbackCoachId String? @unique @map("quarterback_coach_id")
  quarterbackCoach   Coach?  @relation("QuarterbackCoach", fields: [quarterbackCoachId], references: [id])

  runningBacksCoachId String? @unique @map("running_backs_coach_id")
  runningBacksCoach   Coach?  @relation("RunningBacksCoach", fields: [runningBacksCoachId], references: [id])

  wideReceiversCoachId String? @unique @map("wide_receivers_coach_id")
  wideReceiversCoach   Coach?  @relation("WideReceiversCoach", fields: [wideReceiversCoachId], references: [id])

  tightEndsCoachId String? @unique @map("tight_ends_coach_id")
  tightEndsCoach   Coach?  @relation("TightEndsCoach", fields: [tightEndsCoachId], references: [id])

  offensiveLineCoachId String? @unique @map("offensive_line_coach_id")
  offensiveLineCoach   Coach?  @relation("OffensiveLineCoach", fields: [offensiveLineCoachId], references: [id])

  defensiveLineCoachId String? @unique @map("defensive_line_coach_id")
  defensiveLineCoach   Coach?  @relation("DefensiveLineCoach", fields: [defensiveLineCoachId], references: [id])

  linebackersCoachId String? @unique @map("linebackers_coach_id")
  linebackersCoach   Coach?  @relation("LinebackersCoach", fields: [linebackersCoachId], references: [id])

  defensiveBacksCoachId String? @unique @map("defensive_backs_coach_id")
  defensiveBacksCoach   Coach?  @relation("DefensiveBacksCoach", fields: [defensiveBacksCoachId], references: [id])

  strengthAndConditioningCoachId String? @unique @map("strength_and_conditioning_coach_id")
  strengthAndConditioningCoach   Coach?  @relation("StrengthAndConditioningCoach", fields: [strengthAndConditioningCoachId], references: [id])

  qualityControlCoachOffenseId String? @unique @map("quality_control_coach_offense_id")
  qualityControlCoachOffense   Coach?  @relation("QualityControlCoachOffense", fields: [qualityControlCoachOffenseId], references: [id])

  qualityControlCoachDefenseId String? @unique @map("quality_control_coach_defense_id")
  qualityControlCoachDefense   Coach?  @relation("QualityControlCoachDefense", fields: [qualityControlCoachDefenseId], references: [id])

  teamOwnerId String? @unique @map("team_owner_id")
  teamOwner   Staff?  @relation("TeamOwner", fields: [teamOwnerId], references: [id])

  teamPresidentId String? @unique @map("team_president_id")
  teamPresident   Staff?  @relation("TeamPresident", fields: [teamPresidentId], references: [id])

  generalManagerId String? @unique @map("general_manager_id")
  generalManager   Staff?  @relation("GeneralManager", fields: [generalManagerId], references: [id])

  assistantGeneralManagerId String? @unique @map("assistant_general_manager_id")
  assistantGeneralManager   Staff?  @relation("AssistantGeneralManager", fields: [assistantGeneralManagerId], references: [id])

  mediaRelationsManagerId String? @unique @map("media_relations_manager_id")
  mediaRelationsManager   Staff?  @relation("MediaRelationsManager", fields: [mediaRelationsManagerId], references: [id])

  capSpecialistId String? @unique @map("cap_specialist_id")
  capSpecialist   Staff?  @relation("CapSpecialist", fields: [capSpecialistId], references: [id])

  directorPlayerPersonnelId String? @unique @map("director_player_personnel_id")
  directorPlayerPersonnel   Staff?  @relation("DirectorPlayerPersonnel", fields: [directorPlayerPersonnelId], references: [id])

  directorOfProScoutingId String? @unique @map("director_of_pro_scouting_id")
  directorOfProScouting   Staff?  @relation("DirectorOfProScouting", fields: [directorOfProScoutingId], references: [id])

  directorOfCollegeScoutingId String? @unique @map("director_of_college_scouting_id")
  directorOfCollegeScouting   Staff?  @relation("DirectorOfCollegeScouting", fields: [directorOfCollegeScoutingId], references: [id])

